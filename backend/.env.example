# ==========================================
# NOOLZ Backend Environment Configuration
# ==========================================

# Server Port
PORT=5001

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI:
# mongodb+srv://<username>:<password>@<cluster-url>/noolz?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/noolz

# JWT Secrets & Expiration Settings
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRE=7d

# Initial Admin Credentials (used by seed script to generate admin account)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Cloudinary Configuration (obtain from https://cloudinary.com console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
